CLASH_API=http://127.0.0.1:9097
CLASH_SOCKET=/tmp/verge/verge-mihomo.sock
CLASH_SECRET=YOUR_SECRET
CLASH_GROUP=GLOBAL

CLASH_THRESHOLD=200
CLASH_HARD_THRESHOLD=300
CLASH_IMMEDIATE_SCAN_THRESHOLD=500
CLASH_DEGRADED_SCAN_COUNT=2
CLASH_IDEAL_MAX_DELAY=300
CLASH_SAFE_MAX_DELAY=400
CLASH_TIMEOUT_MS=800
CLASH_STABLE_SAMPLES=3

CLASH_PREFILTER_TIMEOUT_MS=1500
CLASH_PROVIDER_REFRESH_INTERVAL=1800
CLASH_AUTO_REFRESH_ON_FAILURE=true
CLASH_REFRESH_COOLDOWN=60

CLASH_PROVIDER_PRIORITY=ProviderA,ProviderB,ProviderC
CLASH_EXCLUDE_KEYWORD=香港,港,HK,HKG,Hong Kong,HongKong,hongkong,剩余流量,套餐到期,距离下次重置

REGION_STICKY=true
PREFERRED_REGION=新加坡
BACKUP_REGIONS=日本,台湾,美国
MIN_REGION_HOLD_SECONDS=1800
SWITCH_COOLDOWN_SECONDS=600

DRY_RUN=false
LOG_LEVEL=INFO
