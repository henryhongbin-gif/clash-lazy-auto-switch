<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user.clash-auto-switch</string>

  <key>WorkingDirectory</key>
  <string>/Users/hotbin/Documents/opencode</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-m</string>
    <string>clash_auto_switch.main</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>CLASH_SECRET</key>
    <string>set-your-secret-here</string>
    <key>CLASH_SOCKET</key>
    <string>/tmp/verge/verge-mihomo.sock</string>
    <key>CLASH_GROUP</key>
    <string>GLOBAL</string>
    <key>CLASH_THRESHOLD</key>
    <string>200</string>
    <key>CLASH_HARD_THRESHOLD</key>
    <string>300</string>
    <key>CLASH_INTERVAL</key>
    <string>3</string>
    <key>CLASH_TIMEOUT_MS</key>
    <string>800</string>
    <key>CLASH_STABLE_SAMPLES</key>
    <string>1</string>
    <key>CLASH_IDEAL_MAX_DELAY</key>
    <string>300</string>
    <key>CLASH_SAFE_MAX_DELAY</key>
    <string>400</string>
    <key>CLASH_PROVIDER_REFRESH_INTERVAL</key>
    <string>1800</string>
    <key>REGION_STICKY</key>
    <string>true</string>
    <key>PREFERRED_REGION</key>
    <string>新加坡</string>
    <key>BACKUP_REGIONS</key>
    <string>日本,香港,台湾,美国</string>
    <key>MIN_REGION_HOLD_SECONDS</key>
    <string>1800</string>
    <key>SWITCH_COOLDOWN_SECONDS</key>
    <string>600</string>
    <key>LOG_LEVEL</key>
    <string>INFO</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/clash-auto-switch.out.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/clash-auto-switch.err.log</string>
</dict>
</plist>
